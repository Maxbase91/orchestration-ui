# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example (this file) is committed.

# ── Browser-exposed (Vite will embed these in the client bundle) ──
# The browser holds no database credential: it posts to the allowlisted /api/db
# boundary. There is no provider switch — Supabase is decommissioned.
#
# Procurement profiles are on by default. Set this to `false` only for a
# deployment whose schema predates the additive procurement_profiles table;
# checkout then asks for the delivery and accounting fields instead of reading
# stored defaults.
VITE_PROCUREMENT_PROFILES_ENABLED=true
# Only the ten legacy integration suites still use these, against the retained
# Supabase project; the application does not. They are unused by the app and can
# go once those suites are rewritten against Neon. Do not put production
# data in a project with open policies.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# ── Server-side (Vercel serverless functions under api/) ──
# Private Neon connection. Never prefix with VITE_ and never expose it to the browser.
NEON_DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/dbname?sslmode=require

# Same URL as above, kept separate so the server code doesn't depend on VITE_ prefix.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Service-role key — bypasses RLS. Used only by server-side handlers that read
# governed configuration or perform controlled administration. NEVER expose it
# with a VITE_ prefix, never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Shared secret for the admin seed endpoint. Pass as `x-admin-secret` header.
ADMIN_SEED_SECRET=change-me-to-a-random-string

# ── AI Assistant chatbot ──
# VITE_ASSISTANT_PROVIDER controls which provider the chat overlay uses.
# "mock" (default) — fully offline, no API key needed, works out of the box.
# "groq" — routes through /api/chat.ts (Phase 2); requires GROQ_API_KEY below.
VITE_ASSISTANT_PROVIDER=groq

# ── Experience-mode pilot ──
# Simple requester mode is available by default. Set these during a pilot to
# restrict it to selected users/roles without changing authorization.
VITE_SIMPLE_EXPERIENCE_ENABLED=true
VITE_SIMPLE_EXPERIENCE_USER_IDS=
VITE_SIMPLE_EXPERIENCE_ROLES=

# Server-side only — NEVER prefix with VITE_. Used by API AI routes.
GROQ_API_KEY=
# Optional Groq model override. Defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
